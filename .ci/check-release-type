#!/usr/bin/env sh
set -eu

# Reads a commit message on stdin (only its first line matters) and takes the
# commit's changed paths as arguments. Fails a feat:, fix: or perf: commit that
# touches no logic path, because release-please decides a release from the commit
# type and only its exclude-paths can look at files, and that takes directory
# prefixes, not root files. rules/releases.md ("Release only when logic code
# changes") has the reasoning.
#
# Logic code is whatever ships in the image: the Dockerfile and .dockerignore.
# REPLACE: add every file or directory a COPY in the Dockerfile pulls in. The
# dev tooling in package.json and bun.lock never reaches the image, so it is not
# logic: use chore(deps): for it, and fix(deps): for a base image bump.
#
# Limits: paths are matched as plain root names, so a path with spaces in a COPY
# would split in the callers' unquoted $(git diff ...). The commit-msg hook sees
# only staged paths, so a message-only amend passes it; CI checks every commit
# and the PR title again, which is the check that counts.

IFS= read -r subject || true

case $subject in
feat | feat[!a-z]* | fix | fix[!a-z]* | perf | perf[!a-z]*) ;;
*) exit 0 ;;
esac

[ "$#" -gt 0 ] || exit 0

for path in "$@"; do
	case $path in
	Dockerfile | .dockerignore) exit 0 ;;
	esac
done

type=${subject%%[!a-z]*}
echo "error: '$type:' commits must touch logic code (Dockerfile, .dockerignore)." >&2
echo "       This one touches none. Use docs:, test:, ci:, build: or chore: instead." >&2
exit 1
